<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- Cron: regenerar cache del Dashboard BI cada noche a las 03:00 -->
        <record id="cron_refresh_dashboard_cache" model="ir.cron">
            <field name="name">Dashboard BI: Regenerar Cache</field>
            <field name="model_id" ref="model_vunkers_dashboard_data"/>
            <field name="state">code</field>
            <field name="code">model.cron_refresh_cache()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="numbercall">-1</field>
            <field name="active">True</field>
            <field name="doall">False</field>
        </record>

    </data>
</odoo>
