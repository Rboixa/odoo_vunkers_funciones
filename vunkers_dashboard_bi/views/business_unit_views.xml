<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ─── Vunkers Service Type ─── -->
    <record id="vunkers_service_type_tree" model="ir.ui.view">
        <field name="name">vunkers.service.type.tree</field>
        <field name="model">vunkers.service.type</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
            </list>
        </field>
    </record>

    <record id="action_vunkers_service_type" model="ir.actions.act_window">
        <field name="name">Tipos de Servicio</field>
        <field name="res_model">vunkers.service.type</field>
        <field name="view_mode">list</field>
    </record>

    <!-- ─── Vunkers Business Area ─── -->
    <record id="vunkers_business_area_tree" model="ir.ui.view">
        <field name="name">vunkers.business.area.tree</field>
        <field name="model">vunkers.business.area</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
            </list>
        </field>
    </record>

    <record id="action_vunkers_business_area" model="ir.actions.act_window">
        <field name="name">Áreas de Negocio</field>
        <field name="res_model">vunkers.business.area</field>
        <field name="view_mode">list</field>
    </record>

    <!-- ─── Vunkers Business Unit ─── -->
    <record id="vunkers_business_unit_tree" model="ir.ui.view">
        <field name="name">vunkers.business.unit.tree</field>
        <field name="model">vunkers.business.unit</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="display_name_dashboard"/>
                <field name="category_id"/>
                <field name="area_id"/>
                <field name="color" widget="color"/>
                <field name="icon"/>
                <field name="is_hidden"/>
            </list>
        </field>
    </record>

    <record id="vunkers_business_unit_form" model="ir.ui.view">
        <field name="name">vunkers.business.unit.form</field>
        <field name="model">vunkers.business.unit</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="display_name_dashboard"/>
                            <field name="category_id"/>
                            <field name="area_id"/>
                            <field name="sequence"/>
                        </group>
                        <group>
                            <field name="color" widget="color"/>
                            <field name="icon"/>
                            <field name="is_hidden"/>
                            <field name="active"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_vunkers_business_unit" model="ir.actions.act_window">
        <field name="name">Business Units</field>
        <field name="res_model">vunkers.business.unit</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- ─── Product Template: add service type field ─── -->
    <record id="product_template_form_inherit_vunkers" model="ir.ui.view">
        <field name="name">product.template.form.vunkers.bi</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_only_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='categ_id']" position="after">
                <field name="vunkers_service_type_id"/>
            </xpath>
        </field>
    </record>

</odoo>
